NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Server-only elevated key: prefer Supabase's sb_secret_... key; legacy service_role keys also work.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-secret-key

# Optional distributed rate limiter (Upstash Redis REST)
UPSTASH_REDIS_REST_URL=https://your-upstash-rest-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# Optional post-insert confirmation email (Resend)
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=MB Learning <trips@example.invalid>
